APP_NAME=MediBook
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local default (SQLite) — uncomment for explicit local DB:
DATABASE_URL=sqlite:///./medibook.db

# Docker / Postgres (used by docker-compose):
# DATABASE_URL=postgresql+psycopg2://medibook:medibook@db:5432/medibook

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@medibook.local

# Twilio SMS (leave empty to log to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio WhatsApp (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=

# Optional Firebase Cloud Messaging
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=

# Payment gateways (demo implementations when keys empty)
# PAYMENT_GATEWAY: upi | mock | stripe | razorpay
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_GATEWAY=upi
UPI_VPA=medibook@upi
UPI_PAYEE_NAME=MediBook Clinic

CORS_ORIGINS=http://localhost:8905
REMINDER_HOURS_BEFORE=24

# Security
CSRF_ENABLED=true
CSRF_TRUSTED_HOSTS=localhost:8905,127.0.0.1:8905,localhost:8000,127.0.0.1:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
HTTPS_ENABLED=false
